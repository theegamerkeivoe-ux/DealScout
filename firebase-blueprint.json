{
  "entities": {
    "Deal": {
      "title": "Deal",
      "description": "A coupon or promo-code deal offer for a merchant",
      "type": "object",
      "properties": {
        "merchantName": {
          "type": "string",
          "description": "Name of the store or merchant"
        },
        "merchantLogo": {
          "type": "string",
          "description": "URL of the merchant logo image"
        },
        "title": {
          "type": "string",
          "description": "Offer headline or promo title"
        },
        "discount": {
          "type": "string",
          "description": "Discount amount or percentage (e.g. 20% OFF)"
        },
        "couponCode": {
          "type": "string",
          "description": "Coupon code to copy, or empty if no code needed"
        },
        "description": {
          "type": "string",
          "description": "Short description of the deal"
        },
        "terms": {
          "type": "string",
          "description": "Terms and conditions if applicable"
        },
        "category": {
          "type": "string",
          "description": "Category name for filtering"
        },
        "affiliateUrl": {
          "type": "string",
          "description": "Destination affiliate or promo URL"
        },
        "startDate": {
          "type": "string",
          "description": "ISO date string for offer start"
        },
        "expirationDate": {
          "type": "string",
          "description": "ISO date string for expiration, or empty"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether this deal is featured prominently on homepage"
        },
        "published": {
          "type": "boolean",
          "description": "Whether this deal is active and published"
        },
        "clicks": {
          "type": "number",
          "description": "Total click count for this deal"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO format"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp in ISO format"
        }
      },
      "required": [
        "merchantName",
        "title",
        "affiliateUrl",
        "published"
      ]
    },
    "ClickLog": {
      "title": "ClickLog",
      "description": "Individual click timestamp log for analytics",
      "type": "object",
      "properties": {
        "dealId": {
          "type": "string",
          "description": "Referenced deal ID"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of click"
        },
        "userAgent": {
          "type": "string",
          "description": "Visitor user agent"
        },
        "referrer": {
          "type": "string",
          "description": "Referrer URL (e.g. YouTube)"
        }
      },
      "required": ["dealId", "timestamp"]
    },
    "SupportComment": {
      "title": "SupportComment",
      "description": "Anonymous user feedback, community question, or deal inquiry",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The comment content / question / feedback"
        },
        "name": {
          "type": "string",
          "description": "Author display moniker (defaults to Anonymous Scout)"
        },
        "dealId": {
          "type": "string",
          "description": "Optional deal ID this comment refers to"
        },
        "dealTitle": {
          "type": "string",
          "description": "Optional title of referenced deal"
        },
        "merchantName": {
          "type": "string",
          "description": "Optional merchant name referenced"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of when the comment was submitted"
        }
      },
      "required": ["text", "createdAt"]
    },
    "Affiliate": {
      "title": "Affiliate",
      "description": "Affiliate partner account with commission tracking",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Affiliate user email address"
        },
        "name": {
          "type": "string",
          "description": "Affiliate display or legal name"
        },
        "affiliateCode": {
          "type": "string",
          "description": "Unique promo referral tracking code"
        },
        "commissionRateFirst": {
          "type": "number",
          "description": "Commission rate for first purchase (0.20 = 20%)"
        },
        "commissionRateRecurring": {
          "type": "number",
          "description": "Recurring commission rate for subsequent purchases (0.10 = 10%)"
        },
        "totalEarned": {
          "type": "number",
          "description": "Lifetime commission earned in USD"
        },
        "pendingBalance": {
          "type": "number",
          "description": "Unpaid balance available for payout in USD"
        },
        "paidBalance": {
          "type": "number",
          "description": "Total paid out commission in USD"
        },
        "totalClicks": {
          "type": "number",
          "description": "Referral click count"
        },
        "totalConversions": {
          "type": "number",
          "description": "Number of promo code conversion uses"
        },
        "payoutMethod": {
          "type": "string",
          "description": "Selected payout method (PayPal, Bank, Crypto)"
        },
        "payoutDetails": {
          "type": "string",
          "description": "Payout destination email or account info"
        },
        "status": {
          "type": "string",
          "description": "Status of the affiliate account (active, paused)"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last profile update ISO timestamp"
        }
      },
      "required": ["email", "affiliateCode", "createdAt"]
    },
    "AffiliateConversion": {
      "title": "AffiliateConversion",
      "description": "Record of a promo code usage generating 20% first-time or 10% recurring commission",
      "type": "object",
      "properties": {
        "affiliateId": {
          "type": "string",
          "description": "Affiliate user ID"
        },
        "affiliateEmail": {
          "type": "string",
          "description": "Affiliate account email"
        },
        "affiliateCode": {
          "type": "string",
          "description": "Affiliate referral code attributed"
        },
        "dealId": {
          "type": "string",
          "description": "ID of the deal promo code used"
        },
        "dealTitle": {
          "type": "string",
          "description": "Title of the deal promo code used"
        },
        "merchantName": {
          "type": "string",
          "description": "Store or merchant name"
        },
        "clientIdentifier": {
          "type": "string",
          "description": "Anonymized client browser ID used to detect first-time vs recurring customer"
        },
        "isFirstUse": {
          "type": "boolean",
          "description": "True if customer's first purchase (20%), false if recurring purchase (10%)"
        },
        "commissionRate": {
          "type": "number",
          "description": "Applied commission rate (0.20 or 0.10)"
        },
        "orderEstimatedValue": {
          "type": "number",
          "description": "Order basket value in USD"
        },
        "commissionAmount": {
          "type": "number",
          "description": "Earned commission in USD"
        },
        "status": {
          "type": "string",
          "description": "Status of conversion (pending, approved, paid)"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of conversion"
        }
      },
      "required": ["affiliateCode", "dealId", "clientIdentifier", "commissionAmount", "timestamp"]
    },
    "AffiliateClick": {
      "title": "AffiliateClick",
      "description": "Tracking event for an affiliate referral link click",
      "type": "object",
      "properties": {
        "affiliateCode": {
          "type": "string",
          "description": "Affiliate code referenced"
        },
        "dealId": {
          "type": "string",
          "description": "Deal viewed or clicked"
        },
        "clientIdentifier": {
          "type": "string",
          "description": "Client identifier"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of click"
        },
        "referrer": {
          "type": "string",
          "description": "HTTP referrer"
        }
      },
      "required": ["affiliateCode", "timestamp"]
    }
  },
  "firestore": {
    "/deals/{dealId}": {
      "schema": "Deal",
      "description": "Collection of coupon and promo deals"
    },
    "/deals/{dealId}/clicks/{clickId}": {
      "schema": "ClickLog",
      "description": "Subcollection of click analytics events for a deal"
    },
    "/support_comments/{commentId}": {
      "schema": "SupportComment",
      "description": "Public community support comments with admin moderation"
    },
    "/affiliates/{affiliateId}": {
      "schema": "Affiliate",
      "description": "Affiliate partner profiles and commission totals"
    },
    "/affiliate_conversions/{conversionId}": {
      "schema": "AffiliateConversion",
      "description": "Conversions and commissions earned from promo code uses"
    },
    "/affiliate_clicks/{clickId}": {
      "schema": "AffiliateClick",
      "description": "Click referral events tracking partner link traffic"
    }
  }
}
