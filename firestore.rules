rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && 
             request.auth.token.email != null && 
             (request.auth.token.email.lower() == 'theegamerkeivoe@gmail.com');
    }

    match /deals/{dealId} {
      // Public visitors can read published deals. Owner can read all deals.
      allow read: if (resource != null && resource.data.published == true) || isOwner();

      // Only the authenticated owner can create and delete deals
      allow create, delete: if isOwner();

      // Owner can update any fields. Non-owners may only increment the click count by exactly 1 on published deals.
      allow update: if isOwner() || (
        resource != null &&
        resource.data.published == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
        request.resource.data.clicks == resource.data.clicks + 1
      );

      // Subcollection for individual click logs
      match /clicks/{clickId} {
        allow create: if true;
        allow read, update, delete: if isOwner();
      }
    }

    match /support_comments/{commentId} {
      // Anyone can read community comments
      allow read: if true;

      // Anyone can anonymously post a comment with valid text
      allow create: if request.resource.data.text is string &&
                    request.resource.data.text.size() > 0 &&
                    request.resource.data.text.size() <= 1500;

      // Only the admin / owner can remove or update comments (moderation)
      allow delete, update: if isOwner();
    }

    // Affiliate Program collections
    match /affiliates/{affiliateId} {
      // Allow read so referral codes can be verified on deal use, and affiliates can view their dashboard
      allow read: if true;

      // Allow creating an affiliate profile with valid email and affiliateCode
      allow create: if request.resource.data.email is string &&
                       request.resource.data.affiliateCode is string;

      // Affiliates can update their own profile (payout details, name), or stats increment on conversion, or admin
      allow update: if isOwner() || 
                    (request.auth != null && (request.auth.uid == affiliateId || (resource.data.email != null && request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower()))) ||
                    request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalClicks', 'totalConversions', 'totalEarned', 'pendingBalance', 'paidBalance', 'updatedAt', 'payoutMethod', 'payoutDetails', 'name', 'status']);

      allow delete: if isOwner();
    }

    match /affiliate_conversions/{conversionId} {
      // Public visitors record a conversion when using a promo code with affiliate referral
      allow create: if true;

      // Allow read so affiliate can view their conversion history in dashboard
      allow read: if true;

      // Only admin can approve, mark as paid, or delete conversions
      allow update, delete: if isOwner();
    }

    match /affiliate_clicks/{clickId} {
      allow create, read: if true;
      allow update, delete: if isOwner();
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
